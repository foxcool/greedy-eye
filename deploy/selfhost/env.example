# Copy to .env next to compose.yaml and fill in the three secrets:
#   cp env.example .env
# `docker compose up` refuses to start while any of them is empty.

# Encrypts the provider API keys the app stores. Generate once and back it up:
# losing it means re-issuing every provider key.
#   openssl rand -base64 32
EYE_SECURITY_MASTERKEY=

# Database passwords. Any long random strings:
#   openssl rand -hex 24
EYE_DB_PASSWORD=
PSINA_DB_PASSWORD=

# --- Optional ---------------------------------------------------------------

# Port on 127.0.0.1 the instance answers on.
# EYE_PORT=8080

# Host name the browser uses to open the instance; session cookies are scoped
# to it. Change it when you reach the instance by another name, e.g. over a VPN.
# It must contain a dot: with a single-label name such as "localhost" sign-in
# does not survive a page reload.
# EYE_HOST=eye.localhost

# Session cookies are Secure by default. Browsers accept that on
# http://*.localhost; for plain http under any other host name set it to false.
# EYE_COOKIE_SECURE=true

# Image versions. Pinned to the releases this file was tested with.
# EYE_VERSION=0.25.0
# EYE_FE_VERSION=0.11.0
# PSINA_VERSION=0.6.0
