# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib
# The compiled binary, at each place a build puts it. Anchored on purpose:
# a bare "eye" also matches the cmd/eye directory and hides its sources.
/eye
/bin/eye
cmd/eye/eye


# Test binary, built with `go test -c`
*.test

# Output of the go coverage tool, specifically when used with LiteIDE
*.out

# Dependency directories (remove the comment below to include it)
vendor

# IDE files
.idea
.cursor

# Secrets
secrets.env
deploy/.env

# Temporary files
tmp
tree.md
.aider*
.cache
.streamlit
*.backup
.devcontainer.json
features.json
.DS_Store

# Claude-specific files (not part of repo)
CLAUDE.md
.claude
